---
// Certificates explained, and the registration slot left honestly empty.
import { certificates } from "../data/process";
---
<div class="pw">
  <div class="pw__head">
    <h2 class="title">The paperwork you get, and what it's for.</h2>
    <p class="lede">The certificate is the only part of the job you can check for yourself. Keep it with the house: a surveyor, buyer or insurer may ask for it.</p>
  </div>
  <dl class="pw__list">
    {certificates.map((c) => <div><dt class="subtitle">{c.name}</dt><dd>{c.when}</dd></div>)}
  </dl>
  <aside class="slot" aria-label="Registration details placeholder">
    <p class="slot__mark">Registration details go here</p>
    <p>A live site shows the electrician's real scheme logo and registration number, with a link to check them. Linework doesn't exist, so it doesn't claim any.</p>
  </aside>
</div>
<style>
  .pw { display: grid; gap: clamp(2rem, 4vw, 3.5rem); }
  .pw__head { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(1.5rem, 5vw, 5rem); align-items: end; }
  .pw__list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; margin: 0; border-top: 1px solid var(--rule); }
  .pw__list > div { padding: 1.1rem clamp(1rem, 2vw, 1.75rem) 1.1rem 0; display: grid; gap: 0.6rem; align-content: start; }
  .pw__list > div + div { padding-left: clamp(1rem, 2vw, 1.75rem); border-left: 1px solid var(--rule); }
  .pw__list dt { font-size: clamp(1.1rem, 1.45vw, 1.3rem); }
  .pw__list dd { margin: 0; }
  .slot {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.5rem 1.5rem;
    align-items: center;
    padding: 1.1rem 1.25rem;
    border: 1px dashed var(--ink-soft);
    border-radius: 3px;
  }
  .slot__mark { font-weight: 620; font-variation-settings: "wdth" 104; }
  @media (max-width: 1040px) { .pw__list { grid-template-columns: 1fr 1fr; } .pw__list > div:nth-child(odd) { padding-left: 0; border-left: 0; } .pw__list > div:nth-child(n+3) { border-top: 1px solid var(--rule); } }
  @media (max-width: 760px) { .pw__head, .slot { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .pw__list { grid-template-columns: 1fr; } .pw__list > div + div { padding-left: 0; border-left: 0; border-top: 1px solid var(--rule); } }
</style>
