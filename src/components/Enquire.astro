---
// The line ends here. Closing call to action on every page.
import { asset, brand } from "../data/site";
const { title = "Tell us what you're planning.", service } = Astro.props;
const href = asset(service ? `/quote/?service=${service}` : "/quote/");
---
<section class="end dusk" aria-labelledby="end-title">
  <div class="wrap end__in">
    <span class="end__node" data-line-node="end" aria-hidden="true"></span>
    <h2 id="end-title" class="display">{title}</h2>
    <div class="end__side">
      <p class="lede">A few questions, about two minutes. You get a straight answer on what happens next, and whether we're the right people for it.</p>
      <div class="end__actions">
        <a class="btn" href={href}><span class="btn__cores" aria-hidden="true"><i></i><i></i><i></i></span>Start your quote</a>
        <button type="button" class="btn btn--ghost" data-demo-contact="phone">Call {brand.phone}</button>
      </div>
    </div>
  </div>
</section>

<style>
  .end { padding-block: var(--section); position: relative; }
  .end__in { display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(2rem, 6vw, 6rem); align-items: end; }
  .end__node { position: absolute; left: 0; top: 0; width: 1px; height: 1px; }
  .end__side { display: grid; gap: 1.5rem; }
  .end__actions { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  @media (max-width: 860px) { .end__in { grid-template-columns: 1fr; } }
</style>
