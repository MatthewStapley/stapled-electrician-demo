---
// Slide between the drawing and the finished room. Both come from one camera.
import { asset } from "../data/site";
---
<div class="cmp" data-compare style="--pos:58%">
  <img class="cmp__a" src={asset("/renders/kitchen-wide-lit.webp")} width="1600" height="1000" alt="The finished room, visualised at dusk with every lighting circuit on." />
  <img class="cmp__b" src={asset("/renders/kitchen-wide-drawn.webp")} width="1600" height="1000" alt="The same room as a line drawing, with the three lighting circuits traced over the ceiling and walls." loading="lazy" />
  <span class="cmp__line" aria-hidden="true"></span>
  <span class="cmp__tag cmp__tag--l" aria-hidden="true">As drawn</span>
  <span class="cmp__tag cmp__tag--r" aria-hidden="true">As lit</span>
  <input type="range" min="0" max="100" value="58" aria-label="Compare the drawing with the finished room" data-compare-input />
</div>
<p class="tag cmp__note">Illustrative visualisation, drawn and rendered for this concept. Drag to compare.</p>
<style>
  .cmp { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--dusk-2); touch-action: pan-y; }
  .cmp img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cmp__b { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .cmp__line { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; margin-left: -1px; background: var(--plate); }
  .cmp__line::after {
    content: ""; position: absolute; top: 50%; left: 50%; width: 3rem; height: 3rem; margin: -1.5rem;
    border-radius: 3px; background: var(--plate);
    box-shadow: 0 6px 18px -6px #000a, inset 0 0 0 7px var(--plate), inset 0 0 0 9px #0002;
  }
  .cmp__tag { position: absolute; top: 0.7rem; padding: 0.15rem 0.5rem; background: var(--dusk); color: var(--on-dusk); font-size: 0.875rem; }
  .cmp__tag--l { left: 0.7rem; } .cmp__tag--r { right: 0.7rem; }
  .cmp input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .cmp:has(input:focus-visible) .cmp__line::after { outline: 3px solid var(--lamp); outline-offset: 2px; }
  .cmp__note { margin-top: 0.6rem; }
</style>
<script>
  document.querySelectorAll<HTMLElement>("[data-compare]").forEach((root) => {
    const input = root.querySelector<HTMLInputElement>("[data-compare-input]")!;
    input.addEventListener("input", () => root.style.setProperty("--pos", `${input.value}%`));
  });
</script>
