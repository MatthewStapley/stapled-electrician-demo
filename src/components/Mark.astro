---
// The three-core mark: live, neutral and earth turning one square corner.
const { size = 30 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true" class="mark">
  <g stroke-width="3">
    <path d="M1 5.5h19a7 7 0 0 1 7 7V31" stroke="var(--mark-l, var(--live))" />
    <path d="M1 12.5h15.5a3.5 3.5 0 0 1 3.5 3.5v15" stroke="var(--mark-n, var(--neutral))" />
    <path d="M1 19.5h11a1 1 0 0 1 1 1V31" stroke="var(--mark-e, var(--earth))" />
    <path d="M1 19.5h11a1 1 0 0 1 1 1V31" stroke="var(--earth-y)" stroke-dasharray="3 3" />
  </g>
</svg>
