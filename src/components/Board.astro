---
// The site menu is a consumer unit: the main switch goes home, and every
// outgoing way is a page. Hovering or focusing a way switches it on.
import Mark from "./Mark.astro";
import { asset, brand } from "../data/site";
import { services } from "../data/services";

const here = Astro.url.pathname;
const ways = [
  ...services.map((s) => ({ n: s.way, label: s.short, href: asset(`/services/${s.slug}/`) })),
  { n: 8, label: "Projects", href: asset("/projects/") },
  { n: 9, label: "How it works", href: asset("/how-it-works/") },
  { n: 10, label: "Get a quote", href: asset("/quote/") },
];
---
<dialog class="board" data-board aria-label="Site menu">
  <div class="board__inner on-dusk">
    <div class="board__top">
      <p class="board__title"><Mark size={26} /> Menu</p>
      <button type="button" class="board__close" data-board-close>Close</button>
    </div>
    <div class="board__unit">
      <a class="way way--main" href={asset("/")} aria-current={here === asset("/") ? "page" : undefined}>
        <span class="way__toggle" aria-hidden="true"><i></i></span>
        <span class="way__label"><span class="way__n">Main switch</span> Home</span>
      </a>
      <ol class="board__ways">
        {ways.map((w) => (
          <li>
            <a class="way" href={w.href} aria-current={here.startsWith(w.href) ? "page" : undefined}>
              <span class="way__toggle" aria-hidden="true"><i></i></span>
              <span class="way__label"><span class="way__n">Way {w.n}</span> {w.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
    <div class="board__foot">
      <p>
        <button type="button" class="link board__contact" data-demo-contact="phone">{brand.phone}</button>
        <button type="button" class="link board__contact" data-demo-contact="email">{brand.email}</button>
      </p>
      <a class="link" href={asset("/concept/")}>About this concept</a>
    </div>
  </div>
</dialog>

<style>
  .board {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--dusk);
    color: var(--on-dusk);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .board[open] { animation: board-in 340ms var(--ease) both; }
  .board::backdrop { background: var(--dusk); }
  @keyframes board-in { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0); } }

  .board__inner {
    min-height: 100%;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: clamp(1.5rem, 4vh, 3rem);
    padding: 1.1rem var(--gutter) 1.5rem;
    --mark-l: var(--live-on-dusk); --mark-n: var(--neutral-on-dusk); --mark-e: var(--earth-on-dusk);
  }
  .board__top { display: flex; justify-content: space-between; align-items: center; }
  .board__title { display: flex; align-items: center; gap: 0.6rem; font-weight: 600; font-variation-settings: "wdth" 116; }
  .board__close {
    min-height: 2.75rem; padding-inline: 1rem;
    background: none; border: 0; color: inherit; font-weight: 620;
    box-shadow: inset 0 0 0 1px currentColor; border-radius: 3px; cursor: pointer;
  }
  .board__unit {
    align-self: center;
    display: grid;
    grid-template-columns: 11.5rem 1fr;
    background: var(--plate);
    color: var(--ink);
    border-radius: 6px;
    padding: clamp(0.6rem, 1.2vw, 1rem);
    gap: clamp(0.5rem, 1vw, 0.9rem);
    box-shadow: 0 0 0 1px #0006, 0 30px 70px -30px #000;
  }
  .board__ways { display: grid; grid-template-columns: repeat(5, 1fr); gap: 2px; background: #c9ccc8; padding: 2px; border-radius: 3px; }
  .board__ways li { display: grid; }
  .way {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: clamp(0.7rem, 1.6vh, 1.1rem);
    padding: clamp(0.7rem, 1.6vh, 1rem);
    background: #fbfbf8;
    color: var(--ink);
    text-decoration: none;
    min-height: clamp(8.5rem, 21vh, 12.5rem);
  }
  .way--main { background: #e9eae5; border-radius: 3px; }
  .way:focus-visible { outline-color: var(--neutral); outline-offset: -3px; }
  .way__toggle {
    position: relative;
    width: 2.1rem;
    height: 3.5rem;
    border-radius: 3px;
    background: #d4d6d1;
    box-shadow: inset 0 1px 3px #0005;
    overflow: hidden;
  }
  .way--main .way__toggle { width: 3rem; background: #bcbfb9; }
  .way__toggle i {
    position: absolute;
    inset: 3px 3px auto;
    height: calc(50% - 3px);
    border-radius: 2px;
    background: var(--dusk);
    box-shadow: 0 1px 2px #0008;
    transform: translateY(100%);
    transition: transform 150ms cubic-bezier(0.5, 0, 0.1, 1.3), background-color 120ms;
  }
  .way--main .way__toggle i { background: var(--live); }
  .way:hover .way__toggle i, .way:focus-visible .way__toggle i, .way[aria-current] .way__toggle i { transform: none; }
  .way__label { align-self: end; font-size: 1.0625rem; line-height: 1.15; font-weight: 600; font-variation-settings: "wdth" 86; }
  .way__n { display: block; margin-bottom: 0.2rem; font-size: 0.875rem; font-weight: 450; color: var(--ink-soft); }
  .board__foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1.5rem; }
  .board__foot p { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; }
  .board__contact { padding: 0.4rem 0; background: none; border: 0; cursor: pointer; }
  @media (max-width: 860px) {
    .board__unit { grid-template-columns: 1fr; align-self: start; }
    .board__ways { grid-template-columns: 1fr 1fr; }
    .way, .way--main {
      grid-template-rows: none;
      grid-template-columns: auto 1fr;
      align-items: center;
      min-height: 4rem;
      padding: 0.55rem 0.6rem;
    }
    .way__toggle, .way--main .way__toggle { width: 1.5rem; height: 2.75rem; }
    .way__label { align-self: center; font-size: 1rem; }
    .way__n { font-size: 0.8125rem; margin: 0; }
  }
  @media (max-width: 380px) { .board__ways { grid-template-columns: 1fr; } }
</style>
