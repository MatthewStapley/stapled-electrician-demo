---
import Mark from "./Mark.astro";
import Board from "./Board.astro";
import { asset, brand, nav } from "../data/site";
const { tone = "sheath" } = Astro.props;
const here = Astro.url.pathname;
---
<header class:list={["head", { "on-dusk": tone === "dusk" }]} data-header>
  <a href={asset("/")} class="head__brand" aria-label={`${brand.name}, home`}>
    <Mark />
    <span>{brand.name}</span>
  </a>
  <nav aria-label="Main" class="head__nav">
    {nav.map((n) => <a href={n.href} aria-current={here.startsWith(n.href) ? "page" : undefined}>{n.label}</a>)}
  </nav>
  <div class="head__actions">
    <a href={asset("/quote/")} class="head__quote">Get a quote</a>
    <button type="button" class="head__menu" data-board-open aria-haspopup="dialog">
      <span class="head__menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="head__menu-word">Menu</span>
    </button>
  </div>
</header>
<Board />

<style>
  .head {
    position: sticky;
    top: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    height: var(--header-h);
    margin-bottom: calc(var(--header-h) * -1);
    padding-inline: var(--gutter);
    color: var(--ink);
    transition: background-color 240ms ease, color 240ms ease, box-shadow 240ms ease;
    view-transition-name: site-header;
  }
  .head.on-dusk { color: var(--on-dusk); --mark-l: var(--live-on-dusk); --mark-n: var(--neutral-on-dusk); --mark-e: var(--earth-on-dusk); }
  .head.is-stuck { background: var(--plate); color: var(--ink); box-shadow: 0 1px 0 var(--rule); --mark-l: var(--live); --mark-n: var(--neutral); --mark-e: var(--earth); }
  .head__brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    text-decoration: none;
    font-size: 1.3rem;
    font-weight: 620;
    font-variation-settings: "wdth" 118;
    letter-spacing: -0.03em;
  }
  .head__nav { display: flex; gap: 0.25rem; }
  .head__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.8rem;
    text-decoration: none;
    font-weight: 500;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-size: 0 1px;
    background-position: 0.8rem calc(100% - 0.55rem);
    transition: background-size 220ms var(--ease);
  }
  .head__nav a:hover, .head__nav a[aria-current] { background-size: calc(100% - 1.6rem) 1px; }
  .head__actions { justify-self: end; display: flex; align-items: center; gap: 0.25rem; }
  .head__quote, .head__menu {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    padding-inline: 0.9rem;
    border: 0;
    border-radius: 3px;
    background: none;
    color: inherit;
    font-weight: 620;
    text-decoration: none;
    cursor: pointer;
  }
  .head__quote { box-shadow: inset 0 0 0 1px currentColor; }
  .head__menu-icon { display: inline-grid; gap: 3px; width: 1.1rem; }
  .head__menu-icon i { height: 2px; background: currentColor; }
  .head__menu-icon i:nth-child(2) { width: 75%; }
  .head__menu-icon i:nth-child(3) { width: 50%; }
  @media (max-width: 900px) {
    .head { grid-template-columns: 1fr auto; }
    .head__nav { display: none; }
  }
  @media (min-width: 901px) {
    .head__menu { padding-inline: 0.7rem; }
  }
  .head__brand :global(svg) { flex: none; }
  .head__quote { white-space: nowrap; }
  @media (max-width: 400px) {
    .head__brand { font-size: 1.15rem; }
    .head__quote { padding-inline: 0.65rem; font-size: 0.95rem; }
    .head__menu { padding-inline: 0.5rem; font-size: 0.95rem; }
  }
  @media (max-width: 359px) {
    .head { gap: 0.4rem; }
    .head__brand { font-size: 1.05rem; gap: 0.4rem; }
    .head__actions { gap: 0; }
    .head__menu-word { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .head__menu { min-width: 2.75rem; justify-content: center; }
  }
</style>
