---
import Layout from "../../layouts/Layout.astro";
import PageHead from "../../components/PageHead.astro";
import Schedule from "../../components/Schedule.astro";
import Paperwork from "../../components/Paperwork.astro";
import Enquire from "../../components/Enquire.astro";
import { asset } from "../../data/site";
import { helper } from "../../data/process";
import { services } from "../../data/services";
---
<Layout title="Services" description="Rewires, consumer units, lighting, EV charge points, testing, renovations and larger projects." sheet="02">
  <PageHead title="What we do, and what it involves." lede="Each service explains what's included, how the job runs and what you're left with. If you're not sure which you need, start with what's happening." />

  <section class="band band--plate" aria-labelledby="helper-title">
    <span data-line-node="left" style="position:absolute;top:0"></span>
    <div class="wrap helper" data-helper>
      <h2 id="helper-title" class="subtitle">What's going on?</h2>
      <div class="helper__opts" role="group" aria-labelledby="helper-title">
        {helper.map((h, i) => <button type="button" class="opt" aria-pressed="false" data-opt={i}>{h.label}</button>)}
      </div>
      <div class="helper__out" aria-live="polite" data-out>
        <p class="helper__idle">Pick one and we'll point you to the right place.</p>
        {helper.map((h, i) => {
          const s = services.find((x) => x.slug === h.slug)!;
          return (
            <div class="helper__ans" data-ans={i} hidden>
              <p class="lede">{h.answer}</p>
              <a class="btn" href={asset(`/services/${s.slug}/`)}><span class="btn__cores" aria-hidden="true"><i></i><i></i><i></i></span>{s.title}</a>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section class="band"><div class="wrap"><Schedule heading="All electrical services" /></div></section>
  <section class="band band--plate"><div class="wrap"><Paperwork /></div></section>
  <Enquire />
</Layout>

<style>
  .helper { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 1.25rem clamp(2rem, 6vw, 6rem); }
  .helper h2 { grid-column: 1 / -1; }
  .helper__opts { display: flex; flex-wrap: wrap; gap: 0.5rem; align-content: start; }
  .opt {
    min-height: 2.9rem;
    padding: 0.5rem 0.95rem;
    background: none;
    border: 0;
    border-radius: 3px;
    box-shadow: inset 0 0 0 1px var(--ink-soft);
    cursor: pointer;
    text-align: left;
    transition: background-color 140ms, color 140ms;
  }
  .opt:hover { background: color-mix(in srgb, var(--ink) 8%, transparent); }
  .opt[aria-pressed="true"] { background: var(--ink); color: var(--plate); box-shadow: none; }
  .helper__ans { display: grid; gap: 1rem; justify-items: start; }
  .helper__ans[hidden], .helper__idle[hidden] { display: none; }
  .helper__idle { color: var(--ink-soft); }
  @media (max-width: 860px) { .helper { grid-template-columns: 1fr; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-helper]");
  if (root) {
    const opts = [...root.querySelectorAll<HTMLButtonElement>("[data-opt]")];
    const ans = [...root.querySelectorAll<HTMLElement>("[data-ans]")];
    const idle = root.querySelector<HTMLElement>(".helper__idle")!;
    opts.forEach((b, i) =>
      b.addEventListener("click", () => {
        opts.forEach((o) => o.setAttribute("aria-pressed", String(o === b)));
        ans.forEach((a, n) => (a.hidden = n !== i));
        idle.hidden = true;
      }),
    );
  }
</script>
